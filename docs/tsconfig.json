{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@claudiu-ceia/ts-duckling": ["../mod.ts"],
      "@claudiu-ceia/combine": ["./node_modules/@claudiu-ceia/combine/mod.ts"],
      "@data/countries-en-us": ["../data/countries-en-us.json"],
      "@data/languages-en": ["../data/languages-en.json"],
      "@data/tlds": ["../data/tlds.json"]
    },
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
